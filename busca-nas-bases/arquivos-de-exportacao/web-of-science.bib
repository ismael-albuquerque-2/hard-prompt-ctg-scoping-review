@inproceedings{ WOS:001711528900350,
Author = {Wang, Yimin and Huang, Qian and Wu, Kaizhi and Guo, Kai},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {LDFS: LLMs with Dynamic Few-Shot for Offensive Language Detection},
Booktitle = {2025 IEEE 24TH INTERNATIONAL CONFERENCE ON TRUST, SECURITY AND PRIVACY
   IN COMPUTING AND COMMUNICATIONS, TRUSTCOM},
Series = {IEEE International Conference on Trust Security and Privacy in Computing
   and Communications},
Year = {2025},
Pages = {3011-3016},
Note = {24th International Conference on Trust Security and Privacy in Computing
   and Communications-TRUSTCOM-Annual, Guiyang, PEOPLES R CHINA, NOV 14-17,
   2025},
Abstract = {The detection of offensive language in social media faces significant
   challenges due to its diverse and evolving expressions, making accurate
   identification remains critical for maintaining healthy online
   ecosystems. While few-shot learning with large language models (LLMs)
   has demonstrated potential in this domain, conventional static
   demonstration selection strategies often fail to adapt to the linguistic
   variability of offensive content, which ultimately limits model
   performance. To address this limitation, we propose LLMs with Dynamic
   Few-Shot (LDFS), a novel method that encodes the training set into dense
   vector representations, retrieves top-k nearest-neighbors for each
   sample, and constructs balanced demonstrations by strategically sampling
   from offensive and non-offensive classes. These demonstrations are
   integrated with the task description and output constraints to construct
   structured prompts that guide the LLMs to perform the classification.
   Comprehensive evaluations on the benchmark datasets COLDataset and
   CDial-Bias reveal that LDFS consistently outperforms conventional
   approaches. The method achieves superior performance compared to random
   10-shot selection, with F1-score improvements reaching up to 14
   percentage points. Notably, LDFS surpasses specialized fine-tuned models
   including COLDETECTOR by 6.82\% and GLM2 P-Prompt by 17.47\% in F1-score
   on the CDial-Bias dataset. These results demonstrate that dynamic,
   semantically-aware demonstration selection can effectively enhance the
   capability of LLMs to recognize offensive language across diverse
   contexts.},
