@inproceedings{ WOS:001606696700059,
Author = {Ren, Nicole and Teo, James},
Editor = {Rehm, G and Li, Y},
Title = {SLENDER: Structured Outputs for SLM-based NER in Low-Resource Englishes},
Booktitle = {PROCEEDINGS OF THE 63RD ANNUAL MEETING OF THE ASSOCIATION FOR
   COMPUTATIONAL LINGUISTICS, VOL 6: INDUSTRY TRACK},
Year = {2025},
Pages = {836-849},
Note = {63rd Association for Computational Linguistics Meeting-ACL-Annual,
   Vienna, AUSTRIA, JUL 27-AUG 01, 2025},
Abstract = {Named Entity Recognition (NER) for low-resource variants of English
   remains challenging, as most NER models are trained on datasets
   predominantly focused on American or British English. While recent work
   has shown that proprietary Large Language Models (LLMs) can perform NER
   effectively in low-resource settings through in-context learning,
   practical deployment is limited by their high computational costs and
   privacy concerns. Open-source Small Language Models (SLMs) offer
   promising alternatives, but the tendency of these Language Models (LM)
   to hallucinate poses challenges for production use. To address this, we
   introduce SLENDER, a novel output format for LM-based NER that achieves
   a three-fold reduction in inference time on average compared to JSON
   format, which is widely used for structured outputs. Our approach using
   Gemma-2-9B-it with the SLENDER output format and constrained decoding in
   zero-shot settings outperforms the en\_core\_web\_trf model from SpaCy,
   an industry-standard NER tool, in all five regions of the Worldwide test
   set.},
