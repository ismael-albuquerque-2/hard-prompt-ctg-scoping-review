@article{ WOS:001790763100001,
Author = {Zhang, Wei and Cao, Yidan and Zhang, Jianrong},
Title = {Knowledge graph-enhanced large language models for explainable causal
   analysis of crane accidents},
Journal = {RELIABILITY ENGINEERING \& SYSTEM SAFETY},
Year = {2026},
Volume = {276},
Month = {DEC},
Abstract = {Crane accidents are characterized by high suddenness, chain-like
   evolution, and strongly coupled causal factors. Traditional
   experience-driven approaches are insufficient for reliable causal
   analysis and evidence-grounded interpretation. This study proposes a
   knowledge graph-enhanced large language model framework for explainable
   causal analysis and question answering in crane accident scenarios. A
   domain-specific ontology for crane accident causation is established
   based on the human-machine-environment-management (HMEM) framework, and
   a multi-stage automated knowledge extraction pipeline is developed.
   Using few-shot prompting, relation enrichment, and self-discrimination
   filtering, the method achieves high-consistency extraction of accident
   entities and relationships, resulting in a high-quality crane accident
   knowledge graph. A Graph Retrieval-Augmented Generation (GraphRAG)
   mechanism is further introduced to integrate BAAI General Embedding
   (BGE)-based semantic vector retrieval with multi-hop causal path
   expansion, enabling the retrieval of structurally constrained causal
   evidence. An evidence-constrained generation strategy ensures that the
   produced responses are logically coherent, consistent with retrieved
   causal evidence, and traceable. The CraneSafe QA prototype system
   supports knowledge extraction, graph visualization, causal chain
   analysis, and interactive reasoning. Experiments demonstrate
   improvements in retrieval accuracy, evidence consistency, and noise
   robustness, with stable performance across queries of varying semantic
   depth. The results indicate that knowledge graph-enhanced large language
   models substantially improve the reliability and interpretability of
   causal analysis in crane accident scenarios.},
